ABRAFLEXI_URL=https://demo.flexibee.eu:5434
ABRAFLEXI_LOGIN=winstrom
ABRAFLEXI_PASSWORD=winstrom
ABRAFLEXI_COMPANY=demo_de

# Data Box credentials. In MultiFlexi these are normally supplied by a
# "Datovka" credential (see vitexsoftware/multiflexi-datovka) assigned to
# this RunTemplate; set them here only when running standalone.
LOGIN=your_databox_login
PASSWORD=your_databox_password
# Path to a PEM client certificate + key for certificate-based login,
# used instead of LOGIN when set (PASSWORD becomes the cert passphrase)
CERT_FILE=
# true = mojedatovaschranka.cz (live), false = czebox.cz (test)
PRODUCTION=False
# Optional: verify credentials authenticate as this data box ID
DATABOX_ID=

# How many days back to look for received messages, and how many at most
ISDS_DAYS=90
ISDS_LIMIT=1000

# Mark a message as downloaded in ISDS once its Event was created in AbraFlexi
ISDS_MARK_AS_READ=False

# Look up the sender's IČO in the ISDS data box directory and link the Event
# to a matching AbraFlexi Adresar record when found
ISDS_RESOLVE_FIRMA=True

# Optional AbraFlexi "typAktivity" code to assign to created Events
ISDS_ABRAFLEXI_EVENT_TYPE=

APP_DEBUG=False
EASE_LOGGER=console
