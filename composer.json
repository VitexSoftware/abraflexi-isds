{
    "name": "vitexsoftware/abraflexi-isds",
    "description": "Synchronize Czech ISDS (data box) messages to Events in AbraFlexi",
    "license": "MIT",
    "authors": [
        {
            "name": "Vítězslav Dvořák",
            "email": "info@vitexsoftware.cz"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "spojenet/flexibee": "^3.7",
        "dfridrich/czech-data-box": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "vitexsoftware/multiflexi-datovka": "Provides the 'Datovka' MultiFlexi credential prototype used for Data Box login (LOGIN/PASSWORD/CERT_FILE/PRODUCTION)"
    },
    "autoload": {
        "psr-4": {
            "AbraFlexiIsds\\": "src/AbraFlexiIsds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\AbraFlexiIsds\\": "tests/AbraFlexiIsds/"
        }
    },
    "type": "project",
    "version": "1.0.0"
}
